# Environment variable = Google Secret Manager secret name
# 仅保存 Secret 名称，不保存真实值。

APP_SECRET_KEY=coffeebear-app-secret-key
ADMIN_PASSWORD=coffeebear-admin-password
DATABASE_URL=coffeebear-database-url
MIGRATION_DATABASE_URL=coffeebear-migration-database-url
POSTGRES_PASSWORD=coffeebear-postgres-password

JACKYUN_APP_KEY=coffeebear-jackyun-app-key
JACKYUN_MCP_TOKEN=coffeebear-jackyun-mcp-token
ALIBABA_1688_APP_KEY=coffeebear-1688-app-key
ALIBABA_1688_APP_SECRET=coffeebear-1688-app-secret
JKY_WEB_SIGN_SECRET=coffeebear-jky-web-sign-secret
JKY_RPA_AGENT_TOKEN=coffeebear-jky-rpa-agent-token

SMTP_PASSWORD=coffeebear-smtp-password

R2_BACKUP_ACCESS_KEY=coffeebear-r2-access-key
R2_BACKUP_SECRET_KEY=coffeebear-r2-secret-key
KODO_COLD_ACCESS_KEY=coffeebear-kodo-access-key
