# 极空间 TEST 示例。复制为 .env 后填写真实值，不要提交 .env。
# CoffeeBear 对外只维护 Test + Production 两套环境。
# APP_ENV=staging 仅作为现有代码中的 Test 兼容运行值，不代表第三套长期环境。
COMPOSE_PROJECT_NAME=ecommerce-test
APP_IMAGE=ghcr.io/jinfenghua1990/coffeebear:candidate
WEB_PORT=8100
APP_ENV=staging
RELEASE_CHANNEL=candidate

POSTGRES_DB=ecommerce_test
# Test owner/admin；与 Production 使用不同密码和数据卷。
POSTGRES_USER=ecommerce_test
POSTGRES_PASSWORD=CHANGE_ME_ADMIN
APP_DB_USER=ecommerce_test_app
APP_DB_PASSWORD=CHANGE_ME_APP
MIGRATOR_DB_USER=ecommerce_test_migrator
MIGRATOR_DB_PASSWORD=CHANGE_ME_MIGRATOR
DATABASE_URL=postgresql+psycopg://ecommerce_test_app:CHANGE_ME_APP@postgres:5432/ecommerce_test
MIGRATION_DATABASE_URL=postgresql+psycopg://ecommerce_test_migrator:CHANGE_ME_MIGRATOR@postgres:5432/ecommerce_test

# 使用极空间“查询路径”得到真实宿主机路径后填写
POSTGRES_DATA_DIR_HOST=/CHANGE_ME/ecommerce/test/postgres
REDIS_DATA_DIR_HOST=/CHANGE_ME/ecommerce/test/redis
DATA_DIR_HOST=/CHANGE_ME/ecommerce/test/data

# 下面继续放 Test 业务运行凭证，例如 APP_SECRET_KEY / ADMIN_* / JACKYUN_* / 1688 / SMTP。
# 禁止复用 Production 密钥、数据库、数据目录或管理员密码。
APP_SECRET_KEY=CHANGE_ME
ACCESS_MODE=rbac
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME
